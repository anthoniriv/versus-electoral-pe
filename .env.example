# Supabase Postgres (Prisma)
# Runtime (Vercel/serverless): usa pooler
DATABASE_URL="postgresql://postgres.<project-ref>:<password-encoded>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1"
# Migraciones Prisma: usa conexión directa
DIRECT_URL="postgresql://postgres:<password-encoded>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"

# Seguridad de endpoints
CRON_SECRET="cambia-este-secreto-largo"
SCRAPE_API_KEY="cambia-este-api-key"

# Clasificador IA con OpenAI (opcional)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Auditoría local de pertenencia de noticias con TypeSafe Jev (opcional)
TYPESAFE_API_KEY=""
TYPESAFE_JEV_MODEL="jev-latest"
# Solo para desarrollo/proxies compatibles; normalmente no hace falta cambiarlo
TYPESAFE_BASE_URL="https://api.typesafe.ai"

# Home totalmente estático (sin query a BD)
NEXT_PUBLIC_HOME_NEWS_COUNT="1756"

# Contador público de visitantes en el footer (GA4 Data API, solo lectura)
GA4_PROPERTY_ID=""
# En Vercel: el JSON completo de la clave de la cuenta de servicio, en una sola línea
GA4_SERVICE_ACCOUNT_JSON=""
# Solo local (alternativa): ruta al archivo de la clave, fuera del repo
GA4_KEY_FILE=""
